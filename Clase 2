import pandas as pd
import numpy as np

datos_caja = {
    "objeto_id": [1,2,3,4,5,6,7],
    "rigidez": ["blando", "rigido", "rigido", "rigido", "medio", "medio", "rigido"],
    "livianez": [1,0,1,1,1,0,1],
    "tamaño": ["Mediano", "Chico", "Chico", "Chico", "Mediano", "Chico", "Chico"],
    "movil": ["NO", "SI", "NO", "SI", "NO", "NO", "NO"],
    "peso": [0.15, 0.09, 0.25, 0.02, 0.12, 0.05, 0.25]
}

#transformacion a df
df_python = pd.DataFrame(datos_caja)

#convertir tipos categoricos y ordinales
df_python["rigidez"] = pd.Categorical(df_python["rigidez"], categories=["blando", "medio", "rigido"], ordered=True)
df_python["tamaño"] = pd.Categorical(df_python["tamaño"], categories=["Chico", "Mediano", "Grande"], ordered=True)
df_python["movil"] = pd.Categorical(df_python["movil"], categories=["NO", "SI"], ordered=True)